---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  stateName?: string;
}

const {
  title = "Free Car Accident Settlement Calculator | FreeInjuryCalc",
  description = "Estimate your car accident settlement value instantly. Free, no sign-up required. Choose from Quick, Detailed, or State-Specific calculation methods.",
  ogImage = "/og-image.png",
  stateName,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://freeinjurycalc.com");

// Setup keywords for On-Page SEO
const baseKeywords = [
  "car accident settlement calculator",
  "passenger car accident settlement calculator",
  "personal injury car accident settlement calculator",
  "free car accident settlement calculator",
  "car accident settlement calculator free"
];

if (stateName) {
  baseKeywords.unshift(
    `car accident settlement calculator ${stateName.toLowerCase()}`,
    `${stateName.toLowerCase()} car accident settlement calculator`,
    `car accident settlement calculator ${stateName.toLowerCase()} free`
  );
} else {
  baseKeywords.push(
    "car accident settlement calculator california",
    "car accident settlement calculator texas",
    "michigan car accident settlement calculator",
    "car accident settlement calculator georgia",
    "car accident settlement calculator virginia",
    "car accident settlement calculator florida",
    "car accident settlement calculator missouri",
    "car accident settlement calculator illinois",
    "car accident settlement calculator arizona",
    "car accident settlement calculator new york",
    "car accident settlement calculator colorado",
    "car accident settlement calculator ohio",
    "car accident settlement calculator ontario",
    "car accident settlement calculator new"
  );
}

const keywordsString = baseKeywords.join(", ");

// JSON-LD Software Application Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": stateName ? `${stateName} Car Accident Settlement Calculator` : "Free Car Accident Settlement Calculator",
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": stateName 
    ? `Calculate your estimated car accident settlement payout in ${stateName} instantly. Auto-calculates based on medical bills, lost wages, and ${stateName}'s comparative negligence laws.`
    : "Estimate your car accident settlement payout instantly. Auto-calculates based on medical bills, lost wages, and state-specific comparative negligence laws."
};

// JSON-LD FAQ Schema for State pages
const faqSchema = stateName ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How is a car accident settlement calculated in ${stateName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Car accident settlements in ${stateName} are calculated by summing your economic damages (such as medical bills, hospitalization fees, ambulance charges, and lost wages) and applying a multiplier (usually 1.5 to 5 depending on severity) to estimate pain and suffering. The final settlement amount is then adjusted according to ${stateName}'s comparative or contributory negligence rules.`
      }
    },
    {
      "@type": "Question",
      "name": `Does ${stateName} limit non-economic damages?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Each state has different rules regarding non-economic damage caps. In some states, pain and suffering damages are uncapped, whereas other states place specific legislative caps. Use the ${stateName} car accident settlement calculator above to get parameters specific to ${stateName} law.`
      }
    }
  ]
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Free Injury" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordsString} />

    <!-- Structured JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Fonts preconnect and load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />

    <!-- Blocking script to initialize theme before painting -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (
          storedTheme === "dark" ||
          (!storedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body class="mesh-gradient min-h-screen flex flex-col bg-canvas-soft text-ink">
    <slot />
  </body>
</html>
