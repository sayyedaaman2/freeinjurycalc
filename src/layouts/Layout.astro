---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  stateName?: string;
  customFaqSchema?: any;
}

const {
  title = "Free Car Accident Settlement Calculator | FreeInjuryCalc",
  description = "Estimate your car accident settlement value instantly. Free, no sign-up required. Choose from Quick, Detailed, or State-Specific calculation methods.",
  ogImage = "/og-image.png",
  stateName,
  customFaqSchema,
} = Astro.props;

let pathname = Astro.url.pathname;
if (pathname.endsWith('index.html')) {
  pathname = pathname.slice(0, -10);
}
if (!pathname.endsWith('/')) {
  pathname += '/';
}
const canonicalURL = new URL(pathname, Astro.site || "https://freeinjurycalc.com");
const isHomepage = pathname === '/';

// WebSite schema for homepage
const websiteSchema = !stateName ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "FreeInjuryCalc",
  "url": "https://freeinjurycalc.com/"
} : null;

// JSON-LD Software Application Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": stateName ? `${stateName} Car Accident Settlement Calculator` : "Free Car Accident Settlement Calculator",
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": stateName 
    ? `Calculate your estimated car accident settlement payout in ${stateName} instantly. Auto-calculates based on medical bills, lost wages, and ${stateName}'s comparative negligence laws.`
    : "Estimate your car accident settlement payout instantly. Auto-calculates based on medical bills, lost wages, and state-specific comparative negligence laws.",
  "dateModified": "2026-06-25T00:00:00+00:00"
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalURL.href,
  "datePublished": "2024-01-01T00:00:00+00:00",
  "dateModified": "2026-06-25T00:00:00+00:00"
};

const webAppSchema = isHomepage ? {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Car Accident Settlement Calculator",
  "url": "https://freeinjurycalc.com",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free car accident settlement calculator for all 50 US states. Estimates settlement value based on medical bills, lost wages, and state negligence laws."
} : null;

// JSON-LD FAQ Schema for State pages
const faqSchema = customFaqSchema || (stateName ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How is a car accident settlement calculated in ${stateName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Car accident settlements in ${stateName} are calculated by summing your economic damages (such as medical bills, hospitalization fees, ambulance charges, and lost wages) and applying a multiplier (usually 1.5 to 5 depending on severity) to estimate pain and suffering. The final settlement amount is then adjusted according to ${stateName}'s comparative or contributory negligence rules.`
      }
    },
    {
      "@type": "Question",
      "name": `Does ${stateName} limit non-economic damages?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Each state has different rules regarding non-economic damage caps. In some states, pain and suffering damages are uncapped, whereas other states place specific legislative caps. Use the ${stateName} car accident settlement calculator above to get parameters specific to ${stateName} law.`
      }
    }
  ]
} : null);

// Breadcrumb Names mapping for standard static routes
const breadcrumbNames: Record<string, string> = {
  "about-us": "About Us",
  "contact-us": "Contact Us",
  "privacy-policy": "Privacy Policy",
  "terms-conditions": "Terms & Conditions",
  "blog": "Blog",
  "workers-compensation-calculator": "Workers' Compensation Calculator",
  "pain-and-suffering-calculator": "Pain and Suffering Calculator",
  "whiplash-settlement-calculator": "Whiplash Settlement Calculator",
  "back-injury-settlement-calculator": "Back Injury Settlement Calculator",
  "neck-injury-settlement-calculator": "Neck Injury Settlement Calculator",
  "slip-and-fall-settlement-calculator": "Slip and Fall Settlement Calculator",
  "motorcycle-accident-settlement-calculator": "Motorcycle Accident Settlement Calculator",
  "truck-accident-settlement-calculator": "Truck Accident Settlement Calculator",
  "florida-diminished-value-calculator": "Florida Diminished Value Calculator",
  "new-york-workers-comp-settlement-calculator": "New York Workers' Comp Settlement Calculator",
};

const origin = Astro.site ? Astro.site.origin : "https://freeinjurycalc.com";
const segments = pathname.split('/').filter(Boolean);

const breadcrumbList = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `${origin}/`
  }
];

if (segments.length > 0) {
  const firstSegment = segments[0];
  
  if (stateName) {
    // State page (could be US state or Ontario Canada)
    const isCanada = firstSegment === 'canada' || pathname.includes('/canada/');
    if (isCanada) {
      breadcrumbList.push(
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Canada",
          "item": `${origin}/#state-laws`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": stateName.includes("Canada") ? `${stateName} Calculator` : `${stateName} (Canada) Calculator`,
          "item": `${origin}${pathname}`
        }
      );
    } else {
      breadcrumbList.push(
        {
          "@type": "ListItem",
          "position": 2,
          "name": "State Calculators",
          "item": `${origin}/#state-laws`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${stateName} Car Accident Settlement Calculator`,
          "item": `${origin}/${firstSegment}/`
        }
      );
    }
  } else {
    // Check if it's a specialty tool page
    const toolSlugs = [
      "workers-compensation-calculator",
      "pain-and-suffering-calculator",
      "whiplash-settlement-calculator",
      "back-injury-settlement-calculator",
      "neck-injury-settlement-calculator",
      "slip-and-fall-settlement-calculator",
      "motorcycle-accident-settlement-calculator",
      "truck-accident-settlement-calculator",
      "florida-diminished-value-calculator",
      "new-york-workers-comp-settlement-calculator"
    ];
    
    if (toolSlugs.includes(firstSegment)) {
      const toolName = breadcrumbNames[firstSegment] || "Calculator";
      breadcrumbList.push(
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": `${origin}/#specialty-calculators`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": toolName,
          "item": `${origin}/${firstSegment}/`
        }
      );
    } else {
      // Standard static pages or blog list or blog post
      let currentPath = "";
      segments.forEach((segment, idx) => {
        currentPath += `/${segment}`;
        let name = breadcrumbNames[segment];
        if (!name) {
          let pageTitleClean = title ? title.replace(" | FreeInjuryCalc", "").replace(" | Free & Anonymous", "").replace(" 2026 — Free Estimate", "") : "";
          name = pageTitleClean || segment.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
        }
        breadcrumbList.push({
          "@type": "ListItem",
          "position": idx + 2,
          "name": name,
          "item": `${origin}${currentPath}/`
        });
      });
    }
  }
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbList
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      if (window.location.hostname === 'www.freeinjurycalc.com') {
        window.location.replace('https://freeinjurycalc.com' + window.location.pathname + window.location.search + window.location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large, index, follow" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RHYP8T4517"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RHYP8T4517');
    </script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Free Injury" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- US English Alternate Link -->
    <link rel="alternate" hreflang="en-US" href={canonicalURL} />

    {isHomepage && (
      <>
        <meta name="geo.region" content="US" />
        <meta name="geo.placename" content="United States" />
        <meta name="geo.position" content="37.09024;-95.712891" />
        <meta name="ICBM" content="37.09024, -95.712891" />
      </>
    )}

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Structured JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    {webAppSchema && <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />


    <!-- Blocking script to initialize theme before painting -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem("theme");
        if (
          storedTheme === "dark" ||
          (!storedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>
  <body class="mesh-gradient min-h-screen flex flex-col bg-canvas-soft text-ink">
    <slot />
  </body>
</html>
