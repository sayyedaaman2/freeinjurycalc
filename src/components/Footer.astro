---
const footerStates = [
  { name: "California", slug: "california" },
  { name: "Texas", slug: "texas" },
  { name: "Florida", slug: "florida" },
  { name: "New York", slug: "new-york" },
  { name: "Illinois", slug: "illinois" },
  { name: "Ohio", slug: "ohio" },
  { name: "Georgia", slug: "georgia" },
  { name: "Michigan", slug: "michigan" },
  { name: "Virginia", slug: "virginia" },
  { name: "Colorado", slug: "colorado" },
  { name: "Arizona", slug: "arizona" },
  { name: "Missouri", slug: "missouri" }
].sort((a, b) => a.name.localeCompare(b.name));
---
<footer class="w-full border-t border-hairline bg-canvas-soft transition-colors duration-200 mt-auto py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-8 mb-12">
      <!-- Info Column -->
      <div class="flex flex-col gap-4 sm:col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="currentColor" fill-opacity="0.1" />
            <path d="M12 8v8M8 12h8" stroke-width="2.5" />
          </svg>
          <span class="text-sm font-semibold tracking-tight text-ink font-sans">
            FreeInjuryCalc
          </span>
        </a>
        <p class="text-xs text-body font-sans leading-relaxed">
          Stark, instant, and completely free car accident settlement estimation for US-based accident victims.
        </p>
        <span class="text-xs text-mute font-mono">
          © {new Date().getFullYear()} FreeInjuryCalc.com. All rights reserved.
        </span>
      </div>

      <!-- Calculators Column -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-4">Calculators</h4>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a href="/whiplash-settlement-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Whiplash Calculator
            </a>
          </li>
          <li>
            <a href="/back-injury-settlement-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Back Injury Calculator
            </a>
          </li>
          <li>
            <a href="/neck-injury-settlement-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Neck Injury Calculator
            </a>
          </li>
          <li>
            <a href="/slip-and-fall-settlement-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Slip & Fall Calculator
            </a>
          </li>
          <li>
            <a href="/motorcycle-accident-settlement-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Motorcycle Calculator
            </a>
          </li>
          <li>
            <a href="/truck-accident-settlement-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Truck Calculator
            </a>
          </li>
          <li>
            <a href="/pain-and-suffering-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Pain & Suffering
            </a>
          </li>
          <li>
            <a href="/workers-compensation-calculator/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Workers' Comp
            </a>
          </li>
        </ul>
      </div>

      <!-- State Guides Column -->
      <div class="md:col-span-2">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-4">State Guides</h4>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5">
          {footerStates.map((state) => (
            <li>
              <a href={`/${state.slug}-car-accident-settlement-calculator/`} class="text-xs text-body hover:text-ink transition-colors duration-200">
                {state.name} Calculator
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Links Column -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-4">Legal & Support</h4>
        <ul class="flex flex-col gap-2.5">
          <li>
            <a href="/blog/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Blog / News
            </a>
          </li>
          <li>
            <a href="/about-us/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              About Us
            </a>
          </li>
          <li>
            <a href="/contact-us/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Contact Us
            </a>
          </li>
          <li>
            <a href="/privacy-policy/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms-conditions/" class="text-xs text-body hover:text-ink transition-colors duration-200">
              Terms & Conditions
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Honesty Disclaimer Box -->
    <div id="disclaimer" class="p-6 border border-hairline bg-canvas rounded-lg transition-colors duration-200">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-2">Important Disclaimer</h3>
      <p class="text-[11px] text-body leading-relaxed font-sans">
        FreeInjuryCalc.com provides instant, automated settlement estimates for car accident claims using standard multiplier formulas (Medical Expenses &times; Injury Multiplier) and general state fault laws. 
        <strong>This calculator is an educational resource and does not constitute formal legal advice.</strong> 
        It does not create an attorney-client relationship. Auto insurance companies evaluate claims using highly complex, proprietary algorithms (e.g., Colossus) and the unique evidence of each crash. 
        If you have suffered injuries, we strongly recommend consulting with a licensed personal injury attorney in your state to receive an accurate, comprehensive legal evaluation of your case.
      </p>
    </div>
  </div>
</footer>
