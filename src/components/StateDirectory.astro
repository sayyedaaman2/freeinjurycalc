---
import { statesData } from "../data/states";

const statesList = Object.values(statesData).sort((a, b) => a.name.localeCompare(b.name));
---
<section id="state-laws" class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
        State Directories
      </span>
      <h2 class="text-2xl font-semibold tracking-tight text-ink mt-4 mb-3 font-sans">
        Car Accident Settlement Calculators by State
      </h2>
      <p class="text-sm text-body font-sans leading-relaxed">
        Personal injury laws differ dramatically in each state. Select your state below to estimate your settlement amount with a calculator adjusted specifically to your local state laws, negligence thresholds, and insurance limits.
      </p>
    </div>

    <!-- State Links Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-y-3 gap-x-4 border-t border-hairline pt-8">
      {statesList.map((state) => (
        <a 
          href={`/${state.slug}-car-accident-settlement-calculator`} 
          class="text-xs text-body hover:text-link hover:underline transition-colors duration-150 py-1.5 flex items-center gap-1.5 font-sans"
        >
          <svg class="w-3.5 h-3.5 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          {state.name} Calculator
        </a>
      ))}
    </div>
    
  </div>
</section>
