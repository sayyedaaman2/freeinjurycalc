---
import { specialCalculators } from "../data/specialCalculators";

const calculatorsList = Object.entries(specialCalculators).map(([key, value]) => ({
  key,
  slug: value.slug,
  title: value.subtitle,
  h1: value.h1.replace(/\.$/, ''), // Remove trailing period for cleaner display
  description: value.intro,
  badge: value.calculatorType === 'workers-comp' ? 'Work Injury' : value.calculatorType === 'slip-and-fall' ? 'Premises' : value.calculatorType === 'pain-suffering' ? 'Non-Economic' : 'Accident'
}));
---
<section id="specialty-calculators" class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <span class="text-[10px] font-bold uppercase tracking-wider text-ink font-mono bg-canvas-soft-2 border border-hairline px-3 py-1 rounded-full">
        Specialty Injury Engines
      </span>
      <h2 class="text-2xl font-semibold tracking-tight text-ink mt-4 mb-3 font-sans">
        Specialized Claims & Injury Settlement Calculators
      </h2>
      <p class="text-sm text-body font-sans leading-relaxed">
        Select a specialized calculator tailored to your specific injury type, accident category, or statutory benefit scheme for more precise valuation.
      </p>
    </div>

    <!-- Specialty Links Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 border-t border-hairline pt-8">
      {calculatorsList.map((calc) => (
        <a 
          href={`/${calc.slug}/`} 
          class="group flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:bg-canvas hover:border-hairline-strong hover:shadow-sm transition-all duration-200"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-[10px] font-semibold font-mono tracking-wider uppercase text-mute bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">
              {calc.badge}
            </span>
            <svg class="w-4 h-4 text-mute group-hover:text-link transition-colors duration-150" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
          
          <h3 class="text-sm font-bold text-ink group-hover:text-link transition-colors duration-150 mb-2 font-sans">
            {calc.h1}
          </h3>
          
          <p class="text-xs text-body leading-relaxed font-sans line-clamp-3">
            {calc.description}
          </p>
        </a>
      ))}
    </div>
    
  </div>
</section>
