---
import { statesData } from "../data/states";
import { stateLegalDetails } from "../data/stateLegalDetails";
import { spinEducationalCard } from "../utils/textSpinner";

interface Props {
  stateName?: string;
  seedName?: string;
}

const { stateName, seedName } = Astro.props;
const seed = stateName || seedName;

// Match state data dynamically
const stateKey = stateName
  ? Object.keys(statesData).find(
      (key) =>
        statesData[key].name.toLowerCase() === stateName.toLowerCase() ||
        statesData[key].name.toLowerCase().includes(stateName.toLowerCase())
    )
  : null;

const stateLaw = stateKey ? statesData[stateKey] : null;
const stateDetails = stateKey ? stateLegalDetails[stateKey] : null;

function getCard(cardNumber: number, defaultTitle: string, defaultText: string) {
  // Override Card 1 (Liability), 5 (Insurance limits), and 6 (PIP/No-fault) for state pages
  if (stateLaw && stateDetails) {
    if (cardNumber === 1) {
      let ruleText = "";
      if (stateLaw.negligenceRule === "contributory") {
        ruleText = `Under ${stateLaw.name}'s strict contributory negligence law (${stateDetails.statuteRef}), any share of fault (even 1%) completely bars you from receiving compensation.`;
      } else if (stateLaw.negligenceRule === "pure") {
        ruleText = `Under ${stateLaw.name}'s pure comparative fault system (${stateDetails.statuteRef}), you can recover damages at any percentage of fault, though your payout is reduced by your fault share.`;
      } else {
        const threshold = stateLaw.negligenceRule === "modified_50" ? "50%" : "51%";
        ruleText = `Under ${stateLaw.name}'s modified comparative negligence standard (${stateDetails.statuteRef}), you can only recover if your fault is below ${threshold}. If you meet or exceed this bar, recovery is prohibited.`;
      }
      return {
        title: `${stateLaw.name} Negligence Rules`,
        text: ruleText
      };
    }
    
    if (cardNumber === 5) {
      return {
        title: `${stateLaw.name} Auto Insurance Limits`,
        text: `Every motorist in ${stateLaw.name} must maintain minimum liability coverage, currently set at <strong>${stateDetails.minInsurance}</strong>. Your payout from the insurer is capped at these policy limits unless you have underinsured motorist coverage or file a personal claim against the driver's assets.`
      };
    }
    
    if (cardNumber === 6) {
      return {
        title: stateLaw.noFault ? "No-Fault PIP Thresholds" : "At-Fault Tort Claim rules",
        text: stateLaw.noFault
          ? `As a no-fault state, ${stateLaw.name} requires Personal Injury Protection (PIP) limits of up to <strong>$${stateLaw.pipLimit.toLocaleString()}</strong>. You cannot file a lawsuit against the other driver unless you meet statutory verbal or medical thresholds.`
          : `${stateLaw.name} is an at-fault (tort) state. There is no PIP requirement to bring a civil action, allowing you to seek economic and non-economic damages from the negligent driver's policy immediately.`
      };
    }
  }

  if (seed) {
    return spinEducationalCard(seed, cardNumber, defaultTitle, defaultText);
  }
  return { title: defaultTitle, text: defaultText };
}
---
<section id="how-it-works" class="py-16 border-t border-hairline bg-canvas-soft-2 transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[10px] font-bold uppercase tracking-wider text-ink font-mono bg-canvas-soft-2 border border-hairline px-3 py-1 rounded-full">
        Legal Breakdown
      </span>
      <h2 class="text-3xl font-semibold tracking-tight text-ink mt-4 mb-3 font-sans">
        {stateName ? `${stateName} Settlement Value Factors` : seedName ? `${seedName} Compensation Factors` : "What affects my settlement amount?"}
      </h2>
      <p class="text-sm text-body font-sans leading-relaxed">
        {stateName 
          ? `Car accident claims in ${stateName} are determined by key legal guidelines, financial evidence, and insurance policy limitations. Here are the six core pillars that govern your case.`
          : seedName
          ? `Evaluating compensation for ${seedName.toLowerCase()} depends on standard diagnostic evidence, personal financial impact, and insurance coverage constraints.`
          : "Car accident settlements are not random. They are calculated based on concrete evidence, financial losses, and local state laws. Here are the five key pillars that decide the value of your claim."}
      </p>
    </div>

    <!-- Features Grid (3 columns desktop, 1 column mobile) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: Fault & Negligence -->
      <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs text-mute font-mono">01 / LIABILITY</span>
          <svg class="w-5 h-5 text-warning" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink font-sans mb-2">
          {getCard(1, "State Negligence Rules", "").title}
        </h3>
        <p class="text-xs text-body leading-relaxed font-sans" set:html={getCard(1, "", "Your compensation is reduced directly by your percentage of fault. In contributory negligence states, even 1% fault bars your recovery entirely.").text} />
      </div>

      <!-- Card 2: Medical Treatment -->
      <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs text-mute font-mono">02 / DAMAGES</span>
          <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink font-sans mb-2">
          {getCard(2, "Medical Bills & Diagnostics", "").title}
        </h3>
        <p class="text-xs text-body leading-relaxed font-sans" set:html={getCard(2, "", "Insurance adjusters use medical bills as the baseline for economic damages. Consistent diagnostic testing, ambulance rides, and hospital records show that your injuries are legitimate, severe, and directly caused by the collision.").text} />
      </div>

      <!-- Card 3: Lost Wages -->
      <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs text-mute font-mono">03 / LOSSES</span>
          <svg class="w-5 h-5 text-violet" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink font-sans mb-2">
          {getCard(3, "Lost Income & Earning Capacity", "").title}
        </h3>
        <p class="text-xs text-body leading-relaxed font-sans" set:html={getCard(3, "", "If you missed work to recover, you are entitled to claim past lost wages. If your injuries cause long-term disability that limits your future employment options, the claims should include estimated future lost earning capacity.").text} />
      </div>

      <!-- Card 4: Pain & Suffering -->
      <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs text-mute font-mono">04 / MULTIPLIER</span>
          <svg class="w-5 h-5 text-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink font-sans mb-2">
          {getCard(4, "Pain and Suffering Multiplier", "").title}
        </h3>
        <p class="text-xs text-body leading-relaxed font-sans" set:html={getCard(4, "", "Non-economic damages cover emotional distress, loss of life enjoyment, and physical pain. Typically estimated by multiplying medical expenses by 1.5 (minor injury) to 5.0 (catastrophic permanent injuries) depending on the severity of the case.").text} />
      </div>

      <!-- Card 5: Policy Limits -->
      <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs text-mute font-mono">05 / CAPACITY</span>
          <svg class="w-5 h-5 text-highlight-pink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink font-sans mb-2">
          {getCard(5, "At-Fault Insurance Limits", "").title}
        </h3>
        <p class="text-xs text-body leading-relaxed font-sans" set:html={getCard(5, "", "Payouts are practically capped by the at-fault driver's insurance policy limits. Even if your damages are high, recovering beyond the insurer's liability maximum is difficult.").text} />
      </div>

      <!-- Card 6: No-Fault Insurance (PIP) -->
      <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs text-mute font-mono">06 / PIP THRESHOLD</span>
          <svg class="w-5 h-5 text-body" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-ink font-sans mb-2">
          {getCard(6, "PIP & Tort Thresholds", "").title}
        </h3>
        <p class="text-xs text-body leading-relaxed font-sans" set:html={getCard(6, "", "In no-fault states, you must claim medical costs from your own PIP insurance first.").text} />
      </div>
      
    </div>
  </div>
</section>
