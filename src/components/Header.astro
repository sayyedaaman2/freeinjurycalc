---
---
<header class="sticky top-0 z-50 w-full h-[64px] border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors duration-200">
  <div class="mx-auto max-w-7xl h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    <!-- Logo and Brand -->
    <a href="/" class="flex items-center gap-2 group">
      <!-- Minimalist geometric logo reminiscent of Vercel -->
      <svg class="w-6 h-6 text-primary transition-transform duration-200 group-hover:scale-105" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L2 22h20L12 2z" />
      </svg>
      <span class="text-sm font-semibold tracking-tight text-ink font-sans hidden sm:inline-block">
        FreeInjuryCalc.com
      </span>
      <span class="text-sm font-semibold tracking-tight text-ink font-sans sm:hidden">
        FreeInjuryCalc
      </span>
    </a>

    <!-- Navigation links -->
    <nav class="hidden md:flex items-center gap-5">
      <a href="/#calculator" class="text-xs text-body hover:text-ink transition-colors duration-200">Calculator</a>
      <a href="/#state-laws" class="text-xs text-body hover:text-ink transition-colors duration-200">State Laws</a>
      <a href="/about-us" class="text-xs text-body hover:text-ink transition-colors duration-200">About Us</a>
      <a href="/contact-us" class="text-xs text-body hover:text-ink transition-colors duration-200">Contact Us</a>
      <a href="/privacy-policy" class="text-xs text-body hover:text-ink transition-colors duration-200">Privacy Policy</a>
      <a href="/terms-conditions" class="text-xs text-body hover:text-ink transition-colors duration-200">Terms</a>
    </nav>

    <!-- Header Actions (Theme Toggle + CTA) -->
    <div class="flex items-center gap-4">
      <!-- Dark/Light Mode Toggle Button -->
      <button 
        id="theme-toggle" 
        class="relative p-2 rounded-full border border-hairline hover:bg-canvas-soft-2 hover:border-hairline-strong transition-all duration-200 cursor-pointer text-ink"
        aria-label="Toggle Theme"
      >
        <!-- Sun Icon -->
        <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon Icon -->
        <svg id="theme-toggle-dark-icon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- Clean Accent CTA Button -->
      <a 
        href="/#calculator" 
        class="inline-flex items-center justify-center px-3 py-1.5 h-8 text-xs font-medium rounded-md bg-primary text-on-primary hover:opacity-90 transition-opacity duration-200"
      >
        Calculate Free
      </a>
    </div>
  </div>
</header>

<script>
  const themeToggleBtn = document.getElementById('theme-toggle');

  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      // Toggle theme class
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }
</script>
