---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Calculator from "../../components/Calculator.astro";
import Educational from "../../components/Educational.astro";
import Footer from "../../components/Footer.astro";
import { statesData } from "../../data/states";

const stateInfo = statesData.ontario;

// Custom page title & description for maximum SEO relevance
const pageTitle = `Ontario Car Accident Settlement Calculator | Free Injury Estimator`;
const pageDescription = `Estimate your car accident settlement value in Ontario instantly. Applies Ontario's specific SABS guidelines, permanent impairment thresholds, and statutory deductibles.`;

function formatUSD(num: number | null) {
  if (num === null) return "$0";
  return new Intl.NumberFormat('en-CA', {
    style: 'currency',
    currency: 'CAD',
    maximumFractionDigits: 0
  }).format(num);
}
---

<Layout title={pageTitle} description={pageDescription} stateName={stateInfo.name}>
  <!-- Header Navigation -->
  <Header />

  <main class="flex-grow">
    <!-- State-Specific Hero Section -->
    <section class="relative pt-16 pb-12 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Back Link -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1 text-xs text-body hover:text-link mb-6 transition-colors duration-150 font-mono"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to National Calculator
        </a>

        <!-- State-Specific Heading -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-tight mb-4">
          Ontario Car Accident Settlement Calculator.
        </h1>
        
        <!-- State-Specific Subheading -->
        <p class="text-base text-body font-sans max-w-2xl mx-auto leading-relaxed mb-6">
          Calculate your estimated claim value adjusted specifically to <span class="text-ink font-semibold">Ontario auto insurance guidelines (SABS)</span>, statutory deductibles, and tort thresholds.
        </p>

        <!-- Brief State Law Quick Glance Badges -->
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Rule: Pure Comparative Fault
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Insurance: No-Fault (SABS)
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Statute of Limitations: 2 Years
          </span>
        </div>
      </div>
    </section>

    <!-- Preselected Calculator -->
    <section id="calculator-section" class="pb-16 px-4 sm:px-6 lg:px-8">
      <Calculator preselectedState="canada/ontario" />
    </section>

    <!-- State Legal Guide Explanation Section -->
    <section class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        
        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Understanding Ontario Car Accident Settlement Laws
        </h2>

        <p class="text-xs text-body leading-relaxed mb-8">
          This specialized <strong>Ontario car accident settlement calculator</strong> helps you estimate potential compensation for personal injury and vehicle damage claims. Unlike US states, auto insurance in Ontario is governed by the Financial Services Regulatory Authority of Ontario (FSRA) and operates under a mixed no-fault/tort structure.
        </p>

        <!-- Grid of detailed state rules -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          
          <!-- Column 1: SABS (No-Fault Benefits) -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              1. Statutory Accident Benefits Schedule (SABS)
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Ontario's no-fault system means your own insurance company pays for medical rehabilitation and income replacement benefits (SABS) up to standard policy limits ($65,000 for non-catastrophic injuries), regardless of who caused the accident.
            </p>
          </div>

          <!-- Column 2: Serious Injury Verbal Threshold -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              2. Verbal Threshold for Pain & Suffering
            </h3>
            <p class="text-xs text-body leading-relaxed">
              To sue the at-fault driver for pain and suffering (non-pecuniary general damages) in civil court, your injury must meet Ontario's strict verbal threshold: a serious and permanent impairment of an important physical, mental, or psychological function.
            </p>
          </div>

          <!-- Column 3: Time Limits (Statute of Limitations) -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              3. Time Limits (Limitations Act)
            </h3>
            <p class="text-xs text-body leading-relaxed">
              In Ontario, you generally have exactly <strong>2 years</strong> from the date of the motor vehicle accident to file a lawsuit against the at-fault party. Additionally, you must notify the at-fault driver of your intent to sue within 120 days of the collision.
            </p>
          </div>

          <!-- Column 4: Statutory Deductible -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              4. Tort Statutory Deductible
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Even if your injuries pass the verbal threshold, pain and suffering awards under a specific amount (approx. $150,000, indexed yearly) are subject to a statutory deductible of roughly $46,000. If your pain and suffering is valued at $50,000, you will only receive $4,000 after the deductible is subtracted.
            </p>
          </div>

        </div>

        <!-- Plain English Summary Card -->
        <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg mb-12">
          <h3 class="text-sm font-semibold text-ink mb-2">Summary of Ontario Car Accident Claims</h3>
          <p class="text-xs text-body leading-relaxed">
            Ontario operates under a no-fault insurance system governed by the Statutory Accident Benefits Schedule (SABS). For pain and suffering lawsuits against the at-fault driver, injuries must meet a verbal threshold of serious and permanent impairment, and non-economic damages are subject to a statutory deductible of about $46,000. Under Ontario's Insurance Act, having detailed records of treatments and lost hours is critical to support your SABS and Tort claim.
          </p>
        </div>

        <!-- State-Specific FAQ Accordion -->
        <div class="mt-12 mb-12 border-t border-hairline pt-12">
          <h3 class="text-xl font-bold text-ink mb-6">
            Frequently Asked Questions about Ontario Accident Claims
          </h3>
          <div class="space-y-4">
            
            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200" open>
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                How is an Ontario car accident settlement calculated?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  Settlements are divided into two categories: 1. Accident Benefits (SABS), paid by your own insurer for medical bills and income replacement (up to 70% of gross salary or $400/week), and 2. Tort Claims, which you file against the at-fault driver for additional pain and suffering and excess lost income.
                </p>
              </div>
            </details>

            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200">
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                What is the statutory deductible in Ontario?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  For pain and suffering claims in Ontario, the Insurance Act mandates a statutory deductible (approximately $46,000 as of recent indexing). This deductible is subtracted from any pain and suffering award that falls below the monetary limit (approx. $150,000). Awards exceeding the limit are not subject to the deductible.
                </p>
              </div>
            </details>

            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200">
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                What does the 120-day notice rule mean in Ontario?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  Under Ontario law, you must provide written notice of your intent to sue the at-fault driver within 120 days of the accident. Failing to meet this notice period can compromise your right to claim pre-judgment interest on your damages.
                </p>
              </div>
            </details>

          </div>
        </div>

        <!-- Lead Capture Mock Consultation -->
        <div id="consult-attorney" class="p-8 border border-hairline bg-canvas rounded-lg text-center shadow-sm relative overflow-hidden">
          <div class="absolute inset-0 bg-radial-gradient from-link/5 to-transparent pointer-events-none"></div>
          <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
            Legal Evaluation
          </span>
          <h3 class="text-xl font-semibold text-ink mt-4 mb-2">
            Speak to an Ontario Personal Injury Lawyer
          </h3>
          <p class="text-xs text-body max-w-lg mx-auto leading-relaxed mb-6">
            Ontario SABS and Tort claim laws are notoriously complex. Connect with an injury lawyer near you to evaluate your threshold status, SABS categories, and calculate the maximum settlement value for your case.
          </p>
          <a 
            href="#consult-attorney" 
            class="inline-block px-5 py-2.5 bg-link hover:bg-link-hover text-canvas font-medium text-xs rounded transition-colors duration-150 font-mono cursor-pointer"
          >
            Need to secure this payout? Get a Free Legal Consultation in Ontario.
          </a>
          <p class="text-[10px] text-mute leading-relaxed font-sans mt-3">
            Insurance adjusters frequently offer low settlements to unrepresented claimants. Get a local lawyer to maximize your claim.
          </p>
        </div>

      </div>
    </section>

    <!-- General Educational section as secondary value -->
    <Educational />
  </main>

  <!-- Footer Section -->
  <Footer />
</Layout>
