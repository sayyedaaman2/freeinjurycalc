---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Calculator from "../../components/Calculator.astro";
import Educational from "../../components/Educational.astro";
import Footer from "../../components/Footer.astro";
import { statesData } from "../../data/states";
import {
  spinNegligence,
  spinInsurance,
  spinStatute,
  spinDamageCap,
  spinSummary,
  spinConsultation,
  spinFAQ1,
  spinFAQ2,
  spinFAQ3,
  spinFAQ4,
  spinFAQ5
} from "../../utils/textSpinner";

const stateInfo = statesData["british-columbia"];
const state = "british-columbia";

// Custom page title & description for British Columbia Canada
const pageTitle = "ICBC Settlement Calculator | British Columbia No-Fault Payouts";
const pageDescription = "Use the British Columbia ICBC settlement calculator. Learn about Enhanced Care no-fault benefits, income replacement, and permanent impairment schedules. Free.";

const relatedSlugs = ["ontario", "alberta", "washington", "oregon"];

function formatUSD(num: number | null) {
  if (num === null) return "$0";
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0
  }).format(num);
}
---

<Layout title={pageTitle} description={pageDescription} stateName={stateInfo.name}>
  <!-- Header Navigation -->
  <Header />

  <main class="flex-grow">
    <!-- Province Hero Section -->
    <section class="relative pt-16 pb-12 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Back Link -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1 text-xs text-body hover:text-link mb-6 transition-colors duration-150 font-mono"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to National Calculator
        </a>

        <!-- Heading -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-tight mb-4">
          ICBC Settlement Calculator.
        </h1>
        
        <!-- Subheading -->
        <p class="text-base text-body font-sans max-w-2xl mx-auto leading-relaxed mb-6">
          Calculate your estimated care benefits and income replacement adjusted specifically to <span class="text-ink font-semibold">British Columbia's ICBC Enhanced Care no-fault laws</span>.
        </p>

        <!-- Brief Law Glance Badges -->
        <div class="flex flex-wrap justify-center gap-2 mb-4">
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Rule: No-Fault (Enhanced Care)
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Right to Sue: Generally Barred
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Statute of Limitations: 2 Years
          </span>
        </div>

        <!-- Last Updated Date -->
        <p class="text-[10px] text-mute font-mono mb-8">
          Last updated: June 2026
        </p>
      </div>
    </section>

    <!-- Preselected Calculator -->
    <section id="calculator-section" class="pb-16 px-4 sm:px-6 lg:px-8">
      <Calculator preselectedState={state} />
    </section>

    <!-- Province Legal Guide Section -->
    <section class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        
        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Understanding British Columbia's ICBC No-Fault Insurance Laws
        </h2>

        <p class="text-xs text-body leading-relaxed mb-8">
          On May 1, 2021, British Columbia transitioned to the <strong>Enhanced Care</strong> no-fault auto insurance model. This legislative change significantly modified how car accident settlements are processed in B.C. Using our <strong>icbc settlement calculator</strong> helps clarify your available statutory benefits under these regulations.
        </p>

        <!-- Grid of detailed rules -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          
          <!-- Column 1: Negligence -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              1. Negligence & Fault Rules
            </h3>
            <p class="text-xs text-body leading-relaxed">
              British Columbia operates under a pure no-fault insurance system for personal injuries. However, ICBC still determines fault for vehicle property damage and premium adjustments. If you are found at fault, your insurance rates may rise, but your access to medical treatment and wage replacement benefits remains unchanged.
            </p>
          </div>

          <!-- Column 2: Insurance Rules -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              2. Enhanced Accident Care Benefits
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Under Enhanced Care, medical and rehabilitation benefits are care-based and practically unlimited based on medical necessity. Approved treatments (such as physiotherapy, chiropractic care, and psychological counseling) are covered directly, so you don't pay out of pocket.
            </p>
          </div>

          <!-- Column 3: Statute of Limitations -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              3. Time Limits (Statute of Limitations)
            </h3>
            <p class="text-xs text-body leading-relaxed">
              You must report your accident to ICBC promptly. In British Columbia, the standard time limit to file a claim for Enhanced Accident Benefits is <strong>2 years</strong> from the date of the accident. Missing this window can result in the loss of all medical and wage benefits.
            </p>
          </div>

          <!-- Column 4: Pain and Suffering Laws -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              4. Pain & Suffering Limitations
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Under the Enhanced Care model, the right to sue an at-fault driver for general pain and suffering is <strong>eliminated</strong> for all B.C. residents. The only exception is if the at-fault driver is convicted of a specific criminal offence related to the crash (e.g., impaired driving). Instead, permanent impairments receive structured lump-sum payouts.
            </p>
          </div>

        </div>

        <!-- Plain English Summary Card -->
        <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg mb-12">
          <h3 class="text-sm font-semibold text-ink mb-2">Summary of BC ICBC Accident Payouts</h3>
          <p class="text-xs text-body leading-relaxed">
            {stateInfo.explanation} If you suffer a permanent impairment (such as loss of limb function or severe cognitive damage), you are eligible for a lump-sum impairment payment of up to approximately $260,000 depending on the percentage rating assigned by your doctor. Income replacement is paid at 90% of your net earnings, up to a maximum limit (currently around $109,000 gross annual income, adjusted yearly).
          </p>
        </div>

        <!-- Province-Specific FAQ Accordion -->
        <div class="mt-12 mb-12 border-t border-hairline pt-12">
          <h3 class="text-xl font-bold text-ink mb-6">
            Frequently Asked Questions about ICBC Claims
          </h3>
          <div class="space-y-4">
            
            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200" open>
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                Can I sue for pain and suffering in British Columbia?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  No. B.C.'s Enhanced Care model has barred general lawsuits for pain and suffering. Instead, ICBC provides care-based accident benefits directly. Lawsuits are restricted to extreme scenarios involving criminal charges, such as street racing or driving under the influence.
                </p>
              </div>
            </details>

            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200">
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                What does the ICBC settlement calculator estimate?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  Because general damages are barred, our calculator estimates the economic benefits you are eligible to recover, including 100% medical treatment coverage and up to 90% income replacement for lost wages (based on 2/3 of weekly wages up to B.C. maximum caps).
                </p>
              </div>
            </details>

            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200">
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                How much does ICBC pay for permanent impairment?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  If a medical professional confirms you have sustained a permanent impairment, you are entitled to a lump-sum payout. The amount depends on the injury rating, ranging from a few thousand dollars for minor permanent impairments up to a maximum statutory cap of over $260,000 for catastrophic impairment.
                </p>
              </div>
            </details>

          </div>
        </div>

        <!-- Consultation box -->
        <div id="consult-attorney" class="p-8 border border-hairline bg-canvas rounded-lg text-center shadow-sm relative overflow-hidden">
          <div class="absolute inset-0 bg-radial-gradient from-link/5 to-transparent pointer-events-none"></div>
          <span class="text-[10px] font-semibold font-mono uppercase tracking-wider text-link mb-3 block">
            Case Evaluation Info
          </span>
          <h3 class="text-lg font-bold text-ink mb-3">
            Having trouble securing your ICBC benefits?
          </h3>
          <p class="text-xs text-body leading-relaxed max-w-xl mx-auto mb-6">
            Although the Enhanced Care model restricts standard tort lawsuits, disputes often arise regarding treatment approvals, income replacement calculations, or permanent impairment ratings. Consulting a lawyer or advocate in B.C. can help you appeal ICBC decisions through the Civil Resolution Tribunal (CRT).
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a 
              href="mailto:consult@freeinjurycalc.com?subject=Free Case Evaluation Request - Province: British Columbia"
              class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold rounded bg-primary text-on-primary hover:opacity-90 transition-opacity"
            >
              Request Advocate Contact
            </a>
            <a 
              href="/#state-laws"
              class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-medium rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-all text-ink"
            >
              Select Another State/Province
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Related Calculators Section -->
    <section class="py-12 border-t border-hairline bg-canvas-soft-2 transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-mute font-mono mb-4 text-center sm:text-left">
          Related Calculators
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {relatedSlugs.map((slug) => {
            const relState = statesData[slug];
            if (!relState) return null;
            const isCanadian = ["ontario", "british-columbia", "alberta"].includes(slug);
            const linkHref = isCanadian
              ? (slug === "british-columbia" ? `/canada/british-columbia-icbc-settlement-calculator/` : `/canada/${slug}-car-accident-settlement-calculator/`)
              : `/${slug}-car-accident-settlement-calculator/`;
            return (
              <a 
                href={linkHref}
                class="flex items-center gap-2 p-3 rounded border border-hairline bg-canvas hover:border-link text-xs font-medium text-ink hover:text-link transition-all font-sans"
              >
                <svg class="w-3.5 h-3.5 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                {relState.name}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- General Educational section as secondary value -->
    <Educational stateName={stateInfo.name} />
  </main>

  <!-- Footer Navigation -->
  <Footer />
</Layout>
