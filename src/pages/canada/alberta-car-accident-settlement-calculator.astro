---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Calculator from "../../components/Calculator.astro";
import Educational from "../../components/Educational.astro";
import Footer from "../../components/Footer.astro";
import { statesData } from "../../data/states";

const stateInfo = statesData.alberta;
const state = "alberta";

// Custom page title & description for Alberta Canada
const pageTitle = "Alberta Car Accident Settlement Calculator | AB Payouts 2026";
const pageDescription = "Calculate your Alberta car accident settlement payout. Applies AB Section B benefits and the 2026 minor injury cap ($6,306). Free.";

const relatedSlugs = ["ontario", "british-columbia", "montana", "north-dakota"];

function formatUSD(num: number | null) {
  if (num === null) return "$0";
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0
  }).format(num);
}
---

<Layout title={pageTitle} description={pageDescription} stateName={stateInfo.name}>
  <!-- Header Navigation -->
  <Header />

  <main class="flex-grow">
    <!-- Province Hero Section -->
    <section class="relative pt-16 pb-12 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Back Link -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1 text-xs text-body hover:text-link mb-6 transition-colors duration-150 font-mono"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to National Calculator
        </a>

        <!-- Heading -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-tight mb-4">
          Alberta Car Accident Settlement Calculator.
        </h1>
        
        <!-- Subheading -->
        <p class="text-base text-body font-sans max-w-2xl mx-auto leading-relaxed mb-6">
          Estimate your estimated claim value adjusted specifically to <span class="text-ink font-semibold">Alberta provincial car accident laws</span>, Section B medical limits, and minor injury caps.
        </p>

        <!-- Brief Law Glance Badges -->
        <div class="flex flex-wrap justify-center gap-2 mb-4">
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Rule: Pure Comparative
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Minor Injury Cap: $6,306 (2026)
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Statute of Limitations: 2 Years
          </span>
        </div>

        <!-- Last Updated Date -->
        <p class="text-[10px] text-mute font-mono mb-8">
          Last updated: June 2026
        </p>
      </div>
    </section>

    <!-- Preselected Calculator -->
    <section id="calculator-section" class="pb-16 px-4 sm:px-6 lg:px-8">
      <Calculator preselectedState={state} />
    </section>

    <!-- Province Legal Guide Section -->
    <section class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        
        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Understanding Alberta Car Accident Settlement Laws
        </h2>

        <p class="text-xs text-body leading-relaxed mb-8">
          Alberta operates under a tort-based auto insurance system. This means that if you are injured due to another driver's negligence, you have the right to file a claim or lawsuit against the at-fault driver's insurance policy to seek compensation. Our <strong>alberta car accident settlement calculator</strong> is designed to estimate payouts using provincial rules, including Section B accident benefits and minor injury caps.
        </p>

        <!-- Grid of detailed rules -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          
          <!-- Column 1: Negligence -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              1. Negligence & Shared Fault
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Alberta follows a pure comparative negligence model. If you share fault for the accident, your final settlement payout is reduced in direct proportion to your percentage of liability. For instance, if you are 25% at fault, your total payout is reduced by 25%. You can still recover compensation even if you are mostly at fault.
            </p>
          </div>

          <!-- Column 2: Section B Accident Benefits -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              2. Section B Benefits
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Every auto policy in Alberta includes mandatory Section B accident benefits. Regardless of fault, Section B covers up to <strong>$50,000</strong> of necessary medical and rehabilitation treatment expenses within 2 years of the crash, as well as modest weekly disability/lost wage checks.
            </p>
          </div>

          <!-- Column 3: Statute of Limitations -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              3. Time Limits (Statute of Limitations)
            </h3>
            <p class="text-xs text-body leading-relaxed">
              In Alberta, the standard statute of limitations for personal injury claims resulting from a motor vehicle accident is <strong>2 years</strong>. You must either settle your claim or file a formal lawsuit in the Alberta Court of King's Bench within 2 years of the crash date.
            </p>
          </div>

          <!-- Column 4: The 2026 Minor Injury Cap -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              4. Pain & Suffering Minor Injury Cap
            </h3>
            <p class="text-xs text-body leading-relaxed">
              Alberta's Minor Injury Regulation (MIR) limits general non-economic damages (pain and suffering) for minor soft-tissue injuries. For accidents occurring in 2026, this cap is set at <strong>$6,306</strong>. This cap is adjusted annually for inflation. However, it does not limit claims for wage loss, out-of-pocket costs, or serious permanent impairments.
            </p>
          </div>

        </div>

        <!-- Plain English Summary Card -->
        <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg mb-12">
          <h3 class="text-sm font-semibold text-ink mb-2">Summary of Alberta Accident Claims</h3>
          <p class="text-xs text-body leading-relaxed">
            {stateInfo.explanation} Note that insurers will frequently attempt to classify injuries (such as whiplash WAD II or chronic muscle strains) under the minor injury cap to limit their payouts. If your injury results in a serious impairment—meaning it prevents you from working or participating in normal activities on a permanent or long-term basis—you can bypass the cap and seek full, uncapped general damages.
          </p>
        </div>

        <!-- Province-Specific FAQ Accordion -->
        <div class="mt-12 mb-12 border-t border-hairline pt-12">
          <h3 class="text-xl font-bold text-ink mb-6">
            Frequently Asked Questions about Alberta Accident Claims
          </h3>
          <div class="space-y-4">
            
            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200" open>
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                What is the minor injury cap in Alberta for 2026?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  For accidents occurring in 2026, the cap on pain and suffering damages for minor injuries is $6,306. Minor injuries include simple sprains, strains, and whiplash-associated disorders (WAD I and II) that resolve without causing permanent physical impairment.
                </p>
              </div>
            </details>

            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200">
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                What does Alberta's Section B cover?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  Section B is a no-fault insurance coverage in Alberta that pays for medical bills, dental care, physical therapy, chiropractic treatments, and prescriptions up to a limit of $50,000 (or for up to 2 years, whichever comes first). It also provides basic disability income replacement checks.
                </p>
              </div>
            </details>

            <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200">
              <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                Is Alberta shifting to a no-fault auto insurance system?
                <span class="transition group-open:rotate-180 text-mute">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                <p>
                  Yes. Alberta has announced plans to transition to a "care-first" no-fault insurance model scheduled to take effect on January 1, 2027. However, accidents occurring in 2026 remain governed by the current tort-based comparative fault system, preserving the right to sue.
                </p>
              </div>
            </details>

          </div>
        </div>

        <!-- Consultation Box -->
        <div id="consult-attorney" class="p-8 border border-hairline bg-canvas rounded-lg text-center shadow-sm relative overflow-hidden">
          <div class="absolute inset-0 bg-radial-gradient from-link/5 to-transparent pointer-events-none"></div>
          <span class="text-[10px] font-semibold font-mono uppercase tracking-wider text-link mb-3 block">
            Case Assessment Info
          </span>
          <h3 class="text-lg font-bold text-ink mb-3">
            Want to challenge the minor injury cap in Alberta?
          </h3>
          <p class="text-xs text-body leading-relaxed max-w-xl mx-auto mb-6">
            Insurers will almost always attempt to classify your soft-tissue injuries under the minor injury cap to keep payouts low. If you have chronic pain or long-term restrictions on work, consulting a qualified Alberta personal injury lawyer is key to bypassing the cap and recovering fair general damages.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a 
              href="mailto:consult@freeinjurycalc.com?subject=Free Case Evaluation Request - Province: Alberta"
              class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold rounded bg-primary text-on-primary hover:opacity-90 transition-opacity"
            >
              Get Free Case Evaluation
            </a>
            <a 
              href="/#state-laws"
              class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-medium rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-all text-ink"
            >
              Select Another State/Province
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Related Calculators Section -->
    <section class="py-12 border-t border-hairline bg-canvas-soft-2 transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-mute font-mono mb-4 text-center sm:text-left">
          Related Calculators
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {relatedSlugs.map((slug) => {
            const relState = statesData[slug];
            if (!relState) return null;
            const isCanadian = ["ontario", "british-columbia", "alberta"].includes(slug);
            const linkHref = isCanadian
              ? (slug === "british-columbia" ? `/canada/british-columbia-icbc-settlement-calculator/` : `/canada/${slug}-car-accident-settlement-calculator/`)
              : `/${slug}-car-accident-settlement-calculator/`;
            return (
              <a 
                href={linkHref}
                class="flex items-center gap-2 p-3 rounded border border-hairline bg-canvas hover:border-link text-xs font-medium text-ink hover:text-link transition-all font-sans"
              >
                <svg class="w-3.5 h-3.5 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                {relState.name}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- General Educational section as secondary value -->
    <Educational stateName={stateInfo.name} />
  </main>

  <!-- Footer Navigation -->
  <Footer />
</Layout>
