---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="Contact Us | FreeInjuryCalc"
  description="Get in touch with the team at FreeInjuryCalc.com. Send feedback, suggest legal database updates, or report website bugs."
>
  <Header />

  <main class="flex-grow bg-canvas transition-colors duration-200 py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 font-sans">
      
      <!-- Page Header -->
      <div class="border-b border-hairline pb-8 mb-12">
        <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
          Get in Touch
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-ink mt-4 mb-4">
          Contact Us
        </h1>
        <p class="text-sm md:text-base text-body leading-relaxed">
          Have feedback on our calculation formulas, suggestions for state negligence guides, or general questions? We would love to hear from you.
        </p>
      </div>

      <!-- Main Layout Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Left: Form Card -->
        <div class="md:col-span-2 space-y-6">
          <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg">
            <h2 class="text-base font-bold text-ink mb-4">Send a Message</h2>
            
            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for your message! We will get back to you shortly.'); this.reset();">
              <div>
                <label for="name" class="block text-[11px] font-medium text-mute font-mono uppercase mb-1">Your Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  class="w-full px-3 py-2 text-xs text-ink bg-canvas border border-hairline rounded-md focus:outline-none focus:border-link transition-colors duration-150"
                  placeholder="Jane Doe"
                />
              </div>

              <div>
                <label for="email" class="block text-[11px] font-medium text-mute font-mono uppercase mb-1">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-3 py-2 text-xs text-ink bg-canvas border border-hairline rounded-md focus:outline-none focus:border-link transition-colors duration-150"
                  placeholder="jane@example.com"
                />
              </div>

              <div>
                <label for="subject" class="block text-[11px] font-medium text-mute font-mono uppercase mb-1">Subject</label>
                <select 
                  id="subject" 
                  name="subject"
                  class="w-full px-3 py-2 text-xs text-ink bg-canvas border border-hairline rounded-md focus:outline-none focus:border-link transition-colors duration-150"
                >
                  <option>General Feedback</option>
                  <option>State Negligence Rule Update</option>
                  <option>Partnerships / Advertising</option>
                  <option>Bug Report</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-[11px] font-medium text-mute font-mono uppercase mb-1">Message</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="4" 
                  required
                  class="w-full px-3 py-2 text-xs text-ink bg-canvas border border-hairline rounded-md focus:outline-none focus:border-link transition-colors duration-150"
                  placeholder="Write your message here..."
                ></textarea>
              </div>

              <button 
                type="submit" 
                class="w-full inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-md bg-primary text-on-primary hover:opacity-90 transition-opacity duration-150 cursor-pointer"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Contact info column -->
        <div class="space-y-6 text-xs text-body leading-relaxed">
          <div class="p-6 border border-hairline rounded-lg bg-canvas">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-3">Email Support</h3>
            <p class="mb-2">
              For direct assistance or data partnership proposals, email our general desk:
            </p>
            <a href="mailto:contact@freeinjurycalc.com" class="text-link hover:underline font-mono font-medium block">
              contact@freeinjurycalc.com
            </a>
          </div>

          <div class="p-6 border border-hairline rounded-lg bg-canvas">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-3">Response Times</h3>
            <p>
              Our operations and code maintenance team reviews feedback during regular business hours (EST). We aim to respond to database corrections and bug reports within 48-72 hours.
            </p>
          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
