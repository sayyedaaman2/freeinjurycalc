---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts, type BlogPost } from "../../data/blog";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Get recent posts excluding current post
const recentPosts = blogPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);
---

<Layout 
  title={`${post.title} | FreeInjuryCalc`}
  description={post.description}
>
  <Header />

  <main class="flex-grow bg-canvas transition-colors duration-200 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 font-sans">
      
      <!-- Back Link -->
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs text-mute hover:text-link transition-colors duration-150 mb-10 font-mono">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to blog
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left 2 columns: Blog Content -->
        <div class="lg:col-span-2">
          <!-- Article Header -->
          <header class="border-b border-hairline pb-8 mb-10">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-[10px] font-semibold tracking-wider uppercase text-link font-mono bg-link-bg-soft/20 dark:bg-link-bg-soft/5 px-2.5 py-0.5 rounded-full">
                {post.category}
              </span>
              <span class="text-[10px] text-mute font-mono">
                {post.date} &bull; {post.readTime}
              </span>
            </div>
            
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-ink leading-tight">
              {post.title}
            </h1>
          </header>

          <!-- Article Content -->
          <article class="prose dark:prose-invert max-w-none text-xs sm:text-sm text-body leading-relaxed space-y-6" set:html={post.content} />
        </div>

        <!-- Right 1 column: Sidebar -->
        <div class="space-y-8">
          
          <!-- Quick Calculator CTA Card -->
          <div class="p-6 border border-hairline bg-primary/5 rounded-lg text-xs leading-relaxed transition-colors duration-200">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink font-mono mb-2">Estimate Your Payout</h3>
            <p class="text-body mb-5">
              Estimate your personal injury claim value instantly using real state-specific insurance formulas. 100% anonymous, free, and immediate.
            </p>
            <a 
              href="/#calculator" 
              class="w-full inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-md bg-primary text-on-primary hover:opacity-90 transition-opacity duration-150"
            >
              Start Free Calculation
            </a>
          </div>

          <!-- Other Articles list -->
          <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-mute mb-4 font-mono">Related Articles</h3>
            <ul class="space-y-4">
              {recentPosts.map((rp) => (
                <li class="border-b border-hairline last:border-b-0 pb-4 last:pb-0">
                  <a href={`/blog/${rp.slug}/`} class="text-xs font-bold text-ink hover:text-link transition-colors duration-150 leading-snug block mb-1">
                    {rp.title}
                  </a>
                  <span class="text-[10px] text-mute font-mono block">
                    {rp.date}
                  </span>
                </li>
              ))}
            </ul>
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
