---

<Layout 
  title="Car Accident Settlement Blog — Expert Guides 2026 | FreeInjuryCalc"
  description="Free expert guides on car accident settlements, insurance claims, pain and suffering, and personal injury compensation for US accident victims. Updated for 2026."
>
  <Header />

  <main class="flex-grow bg-canvas transition-colors duration-200 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 font-sans">
      
      <!-- Section Header -->
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
          Knowledge Center
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink mt-4 mb-4">
          Car Accident Settlement Blog — Expert Guides 2026
        </h1>
        <p class="text-sm sm:text-base text-body leading-relaxed">
          Free, expert-written guides to help US accident victims understand settlement calculations, insurance tactics, pain and suffering compensation, and how to maximize their claim value. All guides reviewed by licensed personal injury attorneys.
        </p>
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {staticPosts.map((post) => (
          <article class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <!-- Category & Read Time -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-semibold tracking-wider uppercase text-link font-mono bg-link-bg-soft/20 dark:bg-link-bg-soft/5 px-2 py-0.5 rounded">
                {post.category}
              </span>
              <span class="text-[10px] text-mute font-mono">
                {post.readTime}
              </span>
            </div>
            
            <!-- Title -->
            <h2 class="text-base font-bold text-ink mb-3 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href={`/blog/${post.slug}/`}>
                {post.title}
              </a>
            </h2>
            
            <!-- Description -->
            <p class="text-xs text-body leading-relaxed mb-6 flex-grow">
              {post.description}
            </p>
            
            <!-- Footer Card -->
            <div class="flex items-center justify-between border-t border-hairline pt-4 mt-auto">
              <span class="text-[10px] text-mute font-mono">
                {post.date}
              </span>
              <span class="text-[11px] font-semibold text-link flex items-center gap-1 group-hover:gap-2 transition-all duration-150">
                Read Article
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </article>
        ))}
      </div>

      <!-- CTA Section -->
      <div class="mt-20 p-8 border border-hairline bg-canvas-soft-2 rounded-xl text-center">
        <h2 class="text-xl font-bold text-ink mb-3">Ready to Estimate Your Settlement?</h2>
        <p class="text-sm text-body mb-6 max-w-xl mx-auto">
          Use our free calculator to get an estimated settlement range for your specific situation — based on your state's actual negligence laws, your injury severity, and your medical bills.
        </p>
        <a href="/" class="inline-flex items-center gap-2 bg-link text-white font-semibold text-sm px-6 py-3 rounded-lg hover:opacity-90 transition-opacity duration-150">
          Use the Free Settlement Calculator →
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
