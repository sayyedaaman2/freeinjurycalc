                <th class="p-3">Calculator Link</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {statesList.map((state) => (
                <tr class="hover:bg-canvas-soft-2 transition-colors duration-150">
                  <td class="p-3 font-semibold text-ink">{state.name}</td>
                  <td class="p-3 font-mono">{state.range}</td>
                  <td class="p-3">
                    <a href={`/${state.slug}-car-accident-settlement-calculator/`} class="text-link hover:underline font-semibold font-mono">
                      Calculate {state.name} &rarr;
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 id="calculator" class="text-lg font-bold text-ink mt-8 mb-4">Calculate Your Own Estimate</h2>
        <p>
          Knowing the average is helpful, but knowing the estimated value of <em>your specific claim</em> is far more valuable. Our free calculator takes your actual numbers — medical bills, lost wages, injury severity, fault percentage — and applies your state's specific negligence laws to generate a personalized estimate.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 my-6">
          <a href="/" class="inline-flex items-center justify-center gap-2 bg-link text-white font-semibold text-xs px-5 py-2.5 rounded-lg hover:opacity-90 transition-opacity duration-150">
            Use the Free Settlement Calculator →
          </a>
          <a href="/florida-car-accident-settlement-calculator/" class="inline-flex items-center justify-center gap-2 border border-hairline text-link text-xs font-semibold px-5 py-2.5 rounded-lg hover:bg-canvas-soft transition-colors duration-150">
            Florida Calculator
          </a>
