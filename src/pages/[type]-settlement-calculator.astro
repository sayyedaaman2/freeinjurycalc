---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Calculator from "../components/Calculator.astro";
import Educational from "../components/Educational.astro";
import SpecialtyCalculators from "../components/SpecialtyCalculators.astro";
import Footer from "../components/Footer.astro";
import { specialCalculators, type SpecialCalculator } from "../data/specialCalculators";

export async function getStaticPaths() {
  const categories = ["whiplash", "back-injury", "neck-injury", "slip-and-fall", "motorcycle-accident", "truck-accident"];
  return categories.map((key) => {
    const data = specialCalculators[key];
    return {
      params: { type: key },
      props: { data },
    };
  });
}

interface Props {
  data: SpecialCalculator;
}

const { data } = Astro.props;
const { type } = Astro.params;
---

<Layout title={data.title} description={data.description}>
  <!-- Header Navigation -->
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative pt-16 pb-12 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Back Link -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1 text-xs text-body hover:text-link mb-6 transition-colors duration-150 font-mono"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to General Calculator
        </a>

        <!-- Custom Heading -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-tight mb-4">
          {data.h1}
        </h1>
        
        <!-- Custom Subheading -->
        <p class="text-base text-body font-sans max-w-2xl mx-auto leading-relaxed mb-6">
          {data.intro}
        </p>

        <!-- Glance badges -->
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Category: {data.subtitle}
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Preset: Severity {data.presetSeverity}x
          </span>
        </div>
      </div>
    </section>

    <!-- Preselected Calculator -->
    <section id="calculator-section" class="pb-16 px-4 sm:px-6 lg:px-8">
      <Calculator 
        preselectedSeverity={data.presetSeverity} 
        preselectedMedBills={data.presetMedBills} 
        preselectedTab={data.presetTab}
        calculatorType={data.calculatorType}
      />
    </section>

    <!-- Specific Guide Section -->
    <section class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 font-sans">
        
        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          {data.aboutHeading1}
        </h2>
        <p class="text-xs text-body leading-relaxed mb-10">
          {data.aboutContent1}
        </p>

        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          {data.aboutHeading2}
        </h2>
        <p class="text-xs text-body leading-relaxed mb-10">
          {data.aboutContent2}
        </p>

        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          How the Settlement Formula Works
        </h2>
        <div class="text-xs text-body leading-relaxed mb-10 space-y-4" set:html={data.formulaExplanation} />

        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Understanding the Calculator Inputs
        </h2>
        <div class="text-xs text-body leading-relaxed mb-10 space-y-4" set:html={data.inputsExplanation} />

        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Worked Payout Examples
        </h2>
        <div class="text-xs text-body leading-relaxed mb-10 space-y-4" set:html={data.workedExamples} />

        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Important Medical & Legal Considerations
        </h2>
        <div class="text-xs text-body leading-relaxed mb-10 space-y-4" set:html={data.legalBackground} />

        <!-- Sources & References Section -->
        {data.sources && data.sources.length > 0 && (
          <div class="mt-10 pt-8 border-t border-hairline">
            <h3 class="text-xl font-bold text-ink mb-4">
              Sources & References
            </h3>
            <ul class="space-y-2 text-xs">
              {data.sources.map((source) => (
                <li class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-link shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  <a 
                    href={source.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-link hover:underline font-mono"
                  >
                    {source.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Accordion FAQs -->
        {data.faqs && data.faqs.length > 0 && (
          <div class="mt-12 mb-12 border-t border-hairline pt-12">
            <h3 class="text-xl font-bold text-ink mb-6">
              Frequently Asked Questions
            </h3>
            <div class="space-y-4">
              {data.faqs.map((faq, index) => (
                <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200" open={index === 0}>
                  <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                    {faq.question}
                    <span class="transition group-open:rotate-180 text-mute">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                    </span>
                  </summary>
                  <div class="text-xs text-body leading-relaxed mt-3">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Neutral Educational Legal Guidance Callout -->
        <div id="consult-attorney" class="p-8 border border-hairline bg-canvas rounded-lg text-center shadow-sm relative overflow-hidden">
          <div class="absolute inset-0 bg-radial-gradient from-link/5 to-transparent pointer-events-none"></div>
          <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
            Legal Guidance
          </span>
          <h3 class="text-xl font-semibold text-ink mt-4 mb-2">
            Consider Professional Legal Advice
          </h3>
          <p class="text-xs text-body max-w-lg mx-auto leading-relaxed mb-6">
            If you have questions about liability, insurance coverage, filing deadlines, or your legal rights, consider speaking with a qualified attorney licensed in your jurisdiction.
          </p>
        </div>

      </div>
    </section>

    <!-- Specialty Calculators Cross-linking Directory Section -->
    <SpecialtyCalculators />

    <!-- General Educational section as secondary value -->
    <Educational seedName={data.subtitle ? data.subtitle.replace(" Valuation", "").replace(" Settlement", "") : data.h1.replace(" Calculator", "")} />
  </main>

  <!-- Footer Section -->
  <Footer />
</Layout>
