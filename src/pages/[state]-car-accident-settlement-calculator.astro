---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Calculator from "../components/Calculator.astro";
import Educational from "../components/Educational.astro";
import Footer from "../components/Footer.astro";
import { statesData, type StateLaw } from "../data/states";
import { stateLegalDetails } from "../data/stateLegalDetails";
import {
  generateNegligenceContent,
  generateInsuranceContent,
  generateStatuteContent,
  generateDamageCapContent,
  generateSummaryContent,
  generateSettlementExample,
  generateFAQs
} from "../utils/stateContentGenerator";

export async function getStaticPaths() {
  return Object.entries(statesData)
    .filter(([slug]) => !['ontario', 'british-columbia', 'alberta'].includes(slug))
    .map(([slug, stateInfo]) => ({
      params: { state: slug },
      props: { stateInfo },
    }));
}

interface Props {
  stateInfo: StateLaw;
}

const { stateInfo } = Astro.props;
const { state } = Astro.params;

const stateDetails = stateLegalDetails[state];

const stateAbbreviations: Record<string, string> = {
  alabama: "AL", alaska: "AK", arizona: "AZ", arkansas: "AR", california: "CA",
  colorado: "CO", connecticut: "CT", delaware: "DE", "district-of-columbia": "DC",
  florida: "FL", georgia: "GA", hawaii: "HI", idaho: "ID", illinois: "IL",
  indiana: "IN", iowa: "IA", kansas: "KS", kentucky: "KY", louisiana: "LA",
  maine: "ME", maryland: "MD", massachusetts: "MA", michigan: "MI", minnesota: "MN",
  mississippi: "MS", missouri: "MO", montana: "MT", nebraska: "NE", nevada: "NV",
  "new-hampshire": "NH", "new-jersey": "NJ", "new-mexico": "NM", "new-york": "NY",
  "north-carolina": "NC", "north-dakota": "ND", ohio: "OH", oklahoma: "OK",
  oregon: "OR", pennsylvania: "PA", "rhode-island": "RI", "south-carolina": "SC",
  "south-dakota": "SD", tennessee: "TN", texas: "TX", utah: "UT", vermont: "VT",
  virginia: "VA", washington: "WA", "west-virginia": "WV", wisconsin: "WI", wyoming: "WY"
};

const adjacentStates: Record<string, string[]> = {
  alabama: ["mississippi", "tennessee", "georgia", "florida"],
  alaska: ["washington", "oregon", "california"],
  arizona: ["california", "nevada", "utah", "new-mexico"],
  arkansas: ["missouri", "tennessee", "mississippi", "louisiana", "texas", "oklahoma"],
  california: ["oregon", "nevada", "arizona"],
  colorado: ["wyoming", "nebraska", "kansas", "oklahoma", "new-mexico", "utah"],
  connecticut: ["new-york", "massachusetts", "rhode-island"],
  delaware: ["maryland", "pennsylvania", "new-jersey"],
  "district-of-columbia": ["maryland", "virginia"],
  florida: ["alabama", "georgia"],
  georgia: ["alabama", "tennessee", "north-carolina", "south-carolina", "florida"],
  hawaii: ["california", "washington", "oregon"],
  idaho: ["washington", "oregon", "nevada", "utah", "wyoming", "montana"],
  illinois: ["wisconsin", "iowa", "missouri", "kentucky", "indiana"],
  indiana: ["illinois", "michigan", "ohio", "kentucky"],
  iowa: ["minnesota", "wisconsin", "illinois", "missouri", "nebraska", "south-dakota"],
  kansas: ["nebraska", "colorado", "oklahoma", "missouri"],
  kentucky: ["indiana", "ohio", "west-virginia", "virginia", "tennessee", "illinois", "missouri"],
  louisiana: ["texas", "arkansas", "mississippi"],
  maine: ["new-hampshire", "massachusetts", "vermont"],
  maryland: ["delaware", "pennsylvania", "west-virginia", "virginia", "district-of-columbia"],
  massachusetts: ["new-york", "vermont", "new-hampshire", "rhode-island", "connecticut"],
  michigan: ["wisconsin", "illinois", "indiana", "ohio"],
  minnesota: ["north-dakota", "south-dakota", "iowa", "wisconsin"],
  mississippi: ["louisiana", "arkansas", "tennessee", "alabama"],
  missouri: ["iowa", "illinois", "kentucky", "tennessee", "arkansas", "oklahoma", "kansas", "nebraska"],
  montana: ["idaho", "wyoming", "south-dakota", "north-dakota"],
  nebraska: ["south-dakota", "wyoming", "colorado", "kansas", "missouri", "iowa"],
  nevada: ["california", "oregon", "idaho", "utah", "arizona"],
  "new-hampshire": ["maine", "vermont", "massachusetts"],
  "new-jersey": ["new-york", "pennsylvania", "delaware"],
  "new-mexico": ["arizona", "utah", "colorado", "oklahoma", "texas"],
  "new-york": ["new-jersey", "pennsylvania", "connecticut", "massachusetts", "vermont"],
  "north-carolina": ["virginia", "tennessee", "georgia", "south-carolina"],
  "north-dakota": ["montana", "south-dakota", "minnesota"],
  ohio: ["michigan", "indiana", "kentucky", "west-virginia", "pennsylvania"],
  oklahoma: ["kansas", "colorado", "new-mexico", "texas", "arkansas", "missouri"],
  oregon: ["washington", "idaho", "nevada", "california"],
  pennsylvania: ["new-york", "new-jersey", "delaware", "maryland", "west-virginia", "ohio"],
  "rhode-island": ["connecticut", "massachusetts"],
  "south-carolina": ["north-carolina", "georgia"],
  "south-dakota": ["north-dakota", "montana", "wyoming", "nebraska", "iowa", "minnesota"],
  tennessee: ["kentucky", "virginia", "north-carolina", "georgia", "alabama", "mississippi", "arkansas", "missouri"],
  texas: ["new-mexico", "oklahoma", "arkansas", "louisiana"],
  utah: ["idaho", "wyoming", "colorado", "new-mexico", "arizona", "nevada"],
  vermont: ["new-york", "new-hampshire", "massachusetts"],
  virginia: ["maryland", "west-virginia", "kentucky", "tennessee", "north-carolina", "district-of-columbia"],
  washington: ["oregon", "idaho"],
  "west-virginia": ["ohio", "pennsylvania", "maryland", "virginia", "kentucky"],
  wisconsin: ["minnesota", "iowa", "illinois", "michigan"],
  wyoming: ["montana", "south-dakota", "nebraska", "colorado", "utah", "idaho"]
};

const abbrev = stateAbbreviations[state] || "";
const relatedSlugs = adjacentStates[state] || [];

// 100% Unique Legal copy compiled dynamically
const negligenceContent = generateNegligenceContent(stateInfo.name, stateInfo.negligenceRule, stateDetails.statuteRef);
const insuranceContent = generateInsuranceContent(stateInfo.name, stateInfo.noFault, stateInfo.pipLimit, stateInfo.verbalThreshold, stateInfo.monetaryThreshold, stateDetails.minInsurance);
const statuteContent = generateStatuteContent(stateInfo.name, stateInfo.statuteOfLimitations, stateDetails.govDeadline);
const damageCapContent = generateDamageCapContent(stateInfo.name, stateInfo.damageCap, stateInfo.damageCapExplanation);
const summaryContent = generateSummaryContent(stateInfo.name, stateInfo.explanation, stateDetails.majorCity, stateDetails.courtName);
const settlementExampleContent = generateSettlementExample(state, stateInfo.name, stateInfo.negligenceRule, stateInfo.damageCap, stateDetails.majorCity, stateDetails.courtName);
const faqs = generateFAQs(stateInfo.name, stateInfo.negligenceRule, stateInfo.statuteOfLimitations, stateInfo.damageCap, stateInfo.noFault, stateInfo.pipLimit, stateInfo.verbalThreshold, stateInfo.monetaryThreshold, stateDetails.statuteRef, stateDetails.courtName);

// Custom page title & description for maximum SEO relevance
const pageTitle = `${stateInfo.name} Car Accident Settlement Calculator | ${abbrev} Payouts`;
const pageDescription = `Calculate your estimated ${stateInfo.name} car accident settlement value. Applies ${stateInfo.name} comparative fault negligence rules under ${stateDetails.statuteRef}, liability limits of ${stateDetails.minInsurance}, and local filing guidelines.`;

// Dynamic custom FAQ Page Schema markup
const customFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title={pageTitle} description={pageDescription} stateName={stateInfo.name} customFaqSchema={customFaqSchema}>
  <!-- Header Navigation -->
  <Header />

  <main class="flex-grow">
    <!-- State-Specific Hero Section -->
    <section class="relative pt-16 pb-12 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Back Link -->
        <a 
          href="/" 
          class="inline-flex items-center gap-1 text-xs text-body hover:text-link mb-6 transition-colors duration-150 font-mono"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Back to National Calculator
        </a>

        <!-- State-Specific Heading -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-tight mb-4">
          {stateInfo.name} Car Accident Settlement Calculator.
        </h1>
        
        <!-- State-Specific Subheading -->
        <p class="text-base text-body font-sans max-w-2xl mx-auto leading-relaxed mb-6">
          Calculate your estimated claim value adjusted specifically to <span class="text-ink font-semibold">{stateInfo.name} state car accident laws</span>, negligence systems, and local liability caps.
        </p>

        <!-- Brief State Law Quick Glance Badges -->
        <div class="flex flex-wrap justify-center gap-2 mb-4">
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Rule: {stateInfo.negligenceRule === 'contributory' ? 'Contributory Negligence' : stateInfo.negligenceRule === 'pure' ? 'Pure Comparative' : 'Modified Comparative'}
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Insurance: {stateInfo.noFault ? 'No-Fault (PIP)' : 'Fault (Tort)'}
          </span>
          <span class="px-2.5 py-1 text-[10px] font-semibold font-mono rounded bg-canvas border border-hairline text-ink">
            Statute of Limitations: {stateInfo.statuteOfLimitations} Years
          </span>
        </div>

        <!-- Last Updated Date -->
        <p class="text-[10px] text-mute font-mono mb-8">
          Last updated: June 2026
        </p>
      </div>
    </section>

    <!-- Preselected Calculator -->
    <section id="calculator-section" class="pb-16 px-4 sm:px-6 lg:px-8">
      <Calculator preselectedState={state} />
    </section>

    <!-- State Legal Guide Explanation Section -->
    <section class="py-16 border-t border-hairline bg-canvas transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        
        <h2 class="text-2xl font-bold tracking-tight text-ink mb-6">
          Understanding {stateInfo.name} Car Accident Settlement Laws
        </h2>

        <p class="text-xs text-body leading-relaxed mb-8">
          This specialized tool helps you estimate potential compensation for personal injury and vehicle damage claims in {stateInfo.name}. Whether you are using this as a driver or a passenger, understanding local statutes of limitations, shared fault negligence systems, and insurance policy guidelines is key to calculating your final payout.
        </p>

        <!-- Grid of detailed state rules -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          
          <!-- Column 1: Negligence -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              1. Negligence & Fault Rules under {stateDetails.statuteRef}
            </h3>
            <p class="text-xs text-body leading-relaxed" set:html={negligenceContent} />
          </div>

          <!-- Column 2: Insurance Rules -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              2. Insurance Requirements ({stateDetails.minInsurance})
            </h3>
            <p class="text-xs text-body leading-relaxed" set:html={insuranceContent} />
          </div>

          <!-- Column 3: Statute of Limitations -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              3. Civil Lawsuit Deadlines (Statute of Limitations)
            </h3>
            <p class="text-xs text-body leading-relaxed" set:html={statuteContent} />
          </div>

          <!-- Column 4: Pain and Suffering Caps -->
          <div class="flex flex-col gap-2">
            <h3 class="text-sm font-semibold uppercase font-mono text-mute">
              4. Pain & Suffering Valuation
            </h3>
            <p class="text-xs text-body leading-relaxed" set:html={damageCapContent} />
          </div>

        </div>

        <!-- Hypothetical localized example -->
        <h3 class="text-base font-bold text-ink mt-8 mb-3">
          Hypothetical Accident Settlement Example in {stateDetails.majorCity}
        </h3>
        <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg mb-12 text-xs text-body leading-relaxed font-sans" set:html={settlementExampleContent} />

        <!-- Plain English Summary Card -->
        <div class="p-6 border border-hairline bg-canvas rounded-lg mb-12">
          <h3 class="text-sm font-semibold text-ink mb-2">Summary of {stateInfo.name} Car Accident Claims</h3>
          <p class="text-xs text-body leading-relaxed" set:html={summaryContent} />
        </div>

        <!-- State-Specific FAQ Accordion -->
        <div class="mt-12 mb-12 border-t border-hairline pt-12">
          <h3 class="text-xl font-bold text-ink mb-6">
            Frequently Asked Questions about {stateInfo.name} Accident Claims
          </h3>
          <div class="space-y-4">
            {faqs.map((faq, index) => (
              <details class="group p-5 border border-hairline bg-canvas rounded-lg transition-all duration-200" open={index === 0}>
                <summary class="flex justify-between items-center font-semibold text-xs text-ink cursor-pointer list-none">
                  {faq.question}
                  <span class="transition group-open:rotate-180 text-mute">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" /></svg>
                  </span>
                </summary>
                <div class="text-xs text-body leading-relaxed mt-3 space-y-2">
                  <p set:html={faq.answer} />
                </div>
              </details>
            ))}
          </div>
        </div>

        <!-- Recommended Guides Section -->
        <div class="mt-12 mb-12 border-t border-hairline pt-12">
          <h3 class="text-xl font-bold text-ink mb-6">
            Recommended Guides for {stateInfo.name} Accident Victims
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-body leading-relaxed font-sans">
            <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg flex flex-col justify-between">
              <div>
                <h4 class="font-bold text-ink mb-2">
                  <a href="/blog/how-car-accident-settlements-are-calculated/" class="hover:text-link transition-colors duration-150">
                    How Car Accident Settlements Are Calculated in 2026
                  </a>
                </h4>
                <p class="text-[11px] leading-relaxed">
                  Understand the exact insurance formula (Medical Bills + Lost Wages &times; Multiplier) and how comparative negligence rules in {stateInfo.name} affect your payout.
                </p>
              </div>
              <a href="/blog/how-car-accident-settlements-are-calculated/" class="text-[11px] font-semibold text-link mt-4 block">Read Guide &rarr;</a>
            </div>

            <div class="p-6 border border-hairline bg-canvas-soft-2 rounded-lg flex flex-col justify-between">
              <div>
                <h4 class="font-bold text-ink mb-2">
                  <a href="/blog/what-is-pain-and-suffering/" class="hover:text-link transition-colors duration-150">
                    What is Pain and Suffering in a Car Accident Claim?
                  </a>
                </h4>
                <p class="text-[11px] leading-relaxed">
                  Deep dive into non-economic damages, how the multiplier vs per diem methods are applied, and how to document pain in {stateInfo.name} for a fairer evaluation.
                </p>
              </div>
              <a href="/blog/what-is-pain-and-suffering/" class="text-[11px] font-semibold text-link mt-4 block">Read Guide &rarr;</a>
            </div>
          </div>
        </div>

        <!-- Lead Capture Mock Consultation -->
        <div id="consult-attorney" class="p-8 border border-hairline bg-canvas rounded-lg text-center shadow-sm relative overflow-hidden">
          <div class="absolute inset-0 bg-radial-gradient from-link/5 to-transparent pointer-events-none"></div>
          <span class="text-[10px] font-semibold font-mono uppercase tracking-wider text-link mb-3 block">
            Free Case Assessment
          </span>
          <h3 class="text-lg font-bold text-ink mb-3">
            Want to maximize your {stateInfo.name} settlement?
          </h3>
          <p class="text-xs text-body leading-relaxed max-w-xl mx-auto mb-6">
            Our calculator estimates basic ballpark ranges. An experienced local personal injury attorney in {stateInfo.name} can review your accident records to identify additional sources of recovery (like umbrella policies, underinsured motorist coverage, or product liability).
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a 
              href={`mailto:consult@freeinjurycalc.com?subject=Free Case Evaluation Request - State: ${stateInfo.name}`}
              class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold rounded bg-primary text-on-primary hover:opacity-90 transition-opacity"
            >
              Get Free Case Evaluation
            </a>
            <a 
              href="/#state-laws"
              class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-medium rounded border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-all text-ink"
            >
              Select Another State
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Related State Calculators Section -->
    <section class="py-12 border-t border-hairline bg-canvas-soft-2 transition-colors duration-200">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 font-sans">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-mute font-mono mb-4 text-center sm:text-left">
          Related State Calculators
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {relatedSlugs.slice(0, 4).map((slug) => {
            const relState = statesData[slug];
            if (!relState) return null;
            const isCanadian = ["ontario", "british-columbia", "alberta"].includes(slug);
            const linkHref = isCanadian
              ? (slug === "british-columbia" ? `/canada/british-columbia-icbc-settlement-calculator/` : `/canada/${slug}-car-accident-settlement-calculator/`)
              : `/${slug}-car-accident-settlement-calculator/`;
            return (
              <a 
                href={linkHref}
                class="flex items-center gap-2 p-3 rounded border border-hairline bg-canvas hover:border-link text-xs font-medium text-ink hover:text-link transition-all font-sans"
              >
                <svg class="w-3.5 h-3.5 text-mute" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                {relState.name}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- General Educational section as secondary value -->
    <Educational stateName={stateInfo.name} />
  </main>

  <!-- Footer Navigation -->
  <Footer />
</Layout>
