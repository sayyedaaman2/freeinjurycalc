---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Calculator from "../components/Calculator.astro";
import Educational from "../components/Educational.astro";
import StateDirectory from "../components/StateDirectory.astro";
import SpecialtyCalculators from "../components/SpecialtyCalculators.astro";
import SeoContent from "../components/SeoContent.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="Free Car Accident Settlement Calculator — All 50 States 2026"
  description="Free car accident settlement calculator for all 50 US states. Instantly estimate your payout using real negligence laws, medical bill multipliers, and insurance caps. No sign-up needed."
>
  <!-- Header Navigation -->
  <Header />

  <!-- Hero Section with Vercel Mesh Gradient Background -->
  <main class="flex-grow">
    <section class="relative pt-20 pb-16 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Badge -->
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full bg-primary text-on-primary font-mono mb-6">
          <svg class="w-3.5 h-3.5 text-cyan animate-pulse" fill="currentColor" viewBox="0 0 20 20">
            <circle cx="10" cy="10" r="6" />
          </svg>
          2026 Legal Engine Updated
        </span>
        
        <!-- Large Heading - Sentence Case with Period-termination -->
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-none mb-6">
          Free Injury Calculator & Accident Settlement Estimator.
        </h1>
        
        <!-- Subheading -->
        <p class="text-base sm:text-lg text-body font-sans max-w-2xl mx-auto leading-relaxed mb-10">
          Calculate a realistic settlement value using real state negligence rules, medical bill multipliers, and insurance caps. 
          <span class="text-ink font-semibold">Free, immediate, and no contact information required.</span>
        </p>
        
        <!-- Quick CTA Arrow Down -->
        <div class="flex justify-center gap-4">
          <a 
            href="#calculator-section" 
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-md bg-primary text-on-primary hover:opacity-95 transition-opacity duration-150 shadow-sm"
          >
            Start Free Calculation
          </a>
          <a 
            href="#how-it-works" 
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-hairline-strong transition-all duration-150 text-ink"
          >
            How it Works
          </a>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section id="calculator-section" class="pb-20 px-4 sm:px-6 lg:px-8">
      <Calculator />
    </section>

    <!-- Educational Section -->
    <Educational />

    <!-- Detailed SEO Content Section -->
    <SeoContent />

    <!-- Specialty Calculators Directory Section -->
    <SpecialtyCalculators />

    <!-- Latest Settlement Guides Section -->
    <section class="py-16 bg-canvas border-t border-hairline transition-colors duration-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
            Expert Resources
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink mt-4 font-sans">
            Latest Accident Settlement Guides & Insights
          </h2>
          <p class="text-xs sm:text-sm text-body leading-relaxed mt-2 max-w-2xl">
            Read our expert-backed guides to learn how settlements are calculated, understand state-specific averages, and discover how to maximize your personal injury claim value.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <!-- Article 1 -->
          <div class="flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">Settlement Calculus</span>
            <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/how-car-accident-settlements-are-calculated/">How Car Accident Settlements Are Calculated in 2026</a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4 flex-grow">The exact formula: medical bills + pain multiplier − fault reduction. Real dollar examples included.</p>
            <a href="/blog/how-car-accident-settlements-are-calculated/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">Read Guide &rarr;</a>
          </div>

          <!-- Article 2 -->
          <div class="flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">Legal Geography</span>
            <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/average-car-accident-settlement-by-state/">Average Car Accident Settlement Amounts by State 2026</a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4 flex-grow">Real settlement ranges by injury type and state. Full 50-state comparison table included.</p>
            <a href="/blog/average-car-accident-settlement-by-state/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">Read Guide &rarr;</a>
          </div>

          <!-- Article 3 -->
          <div class="flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">Negotiation Guide</span>
            <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/how-to-negotiate-car-accident-settlement/">How to Negotiate a Car Accident Settlement — Step-by-Step</a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4 flex-grow">Demand letters, adjuster tactics, counter-offer strategies, and when to walk away.</p>
            <a href="/blog/how-to-negotiate-car-accident-settlement/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">Read Guide &rarr;</a>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          <!-- Article 4 -->
          <div class="flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">Injury Guide</span>
            <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/whiplash-settlement-amounts/">Whiplash Settlement Amounts in 2026 — What to Expect</a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4 flex-grow">Settlement ranges by severity, why MRI findings change everything, and how to maximize your claim.</p>
            <a href="/blog/whiplash-settlement-amounts/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">Read Guide &rarr;</a>
          </div>

          <!-- Article 5 -->
          <div class="flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">Legal Advice</span>
            <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/do-i-need-a-lawyer-for-car-accident/">Do I Need a Lawyer for a Car Accident Settlement?</a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4 flex-grow">Honest breakdown: when to hire an attorney vs. handle it yourself — with real net recovery math.</p>
            <a href="/blog/do-i-need-a-lawyer-for-car-accident/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">Read Guide &rarr;</a>
          </div>

          <!-- Article 6 -->
          <div class="flex flex-col p-5 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">Legal Deadlines</span>
            <h3 class="text-sm font-bold text-ink mb-2 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/how-long-after-car-accident-can-you-claim/">How Long After a Car Accident Can You Claim?</a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-4 flex-grow">Statute of limitations for all 50 states, government vehicle deadlines, and what happens if you miss yours.</p>
            <a href="/blog/how-long-after-car-accident-can-you-claim/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">Read Guide &rarr;</a>
          </div>
        </div>

        <div class="text-center">
          <a 
            href="/blog/" 
            class="inline-flex items-center justify-center px-6 py-2.5 text-xs font-semibold rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-hairline-strong transition-all duration-150 text-ink"
          >
            Browse All 10 Guides &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- State Directory Link Section -->
    <StateDirectory />
  </main>

  <!-- Footer Navigation -->
  <Footer />
</Layout>
