---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Calculator from "../components/Calculator.astro";
import Educational from "../components/Educational.astro";
import StateDirectory from "../components/StateDirectory.astro";
import SpecialtyCalculators from "../components/SpecialtyCalculators.astro";
import SeoContent from "../components/SeoContent.astro";
import Footer from "../components/Footer.astro";
---

<Layout 
  title="Free Injury Calculator & Accident Settlement Payout Estimator"
  description="Estimate your claim value or car accident settlement with our free injury calculator. Accurate compensation payouts based on medical bills, lost wages, and negligence rules."
>
  <!-- Header Navigation -->
  <Header />

  <!-- Hero Section with Vercel Mesh Gradient Background -->
  <main class="flex-grow">
    <section class="relative pt-20 pb-16 overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Badge -->
        <span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full bg-primary text-on-primary font-mono mb-6">
          <svg class="w-3.5 h-3.5 text-cyan animate-pulse" fill="currentColor" viewBox="0 0 20 20">
            <circle cx="10" cy="10" r="6" />
          </svg>
          2026 Legal Engine Updated
        </span>
        
        <!-- Large Heading - Sentence Case with Period-termination -->
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-ink font-sans max-w-4xl mx-auto leading-none mb-6">
          Free Injury Calculator & Accident Settlement Estimator.
        </h1>
        
        <!-- Subheading -->
        <p class="text-base sm:text-lg text-body font-sans max-w-2xl mx-auto leading-relaxed mb-10">
          Calculate a realistic settlement value using real state negligence rules, medical bill multipliers, and insurance caps. 
          <span class="text-ink font-semibold">Free, immediate, and no contact information required.</span>
        </p>
        
        <!-- Quick CTA Arrow Down -->
        <div class="flex justify-center gap-4">
          <a 
            href="#calculator-section" 
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-md bg-primary text-on-primary hover:opacity-95 transition-opacity duration-150 shadow-sm"
          >
            Start Free Calculation
          </a>
          <a 
            href="#how-it-works" 
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-hairline-strong transition-all duration-150 text-ink"
          >
            How it Works
          </a>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section id="calculator-section" class="pb-20 px-4 sm:px-6 lg:px-8">
      <Calculator />
    </section>

    <!-- Educational Section -->
    <Educational />

    <!-- Detailed SEO Content Section -->
    <SeoContent />

    <!-- Specialty Calculators Directory Section -->
    <SpecialtyCalculators />

    <!-- Latest Settlement Guides Section -->
    <section class="py-16 bg-canvas border-t border-hairline transition-colors duration-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-link font-mono bg-link-bg-soft/30 dark:bg-link-bg-soft/10 px-3 py-1 rounded-full">
            Expert Resources
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink mt-4 font-sans">
            Latest Accident Settlement Guides & Insights
          </h2>
          <p class="text-xs sm:text-sm text-body leading-relaxed mt-2 max-w-2xl">
            Read our expert-backed guides to learn how settlements are calculated, understand state-specific averages, and discover how to maximize your personal injury claim value.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
          <!-- Article 1 -->
          <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">
              Settlement Calculus
            </span>
            <h3 class="text-sm font-bold text-ink mb-3 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/how-car-accident-settlements-are-calculated/">
                How Car Accident Settlements Are Calculated in 2026
              </a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-6 flex-grow">
              Learn the exact formulas insurance adjusters use, including the multiplier method, to calculate your medical expenses, lost wages, and pain and suffering.
            </p>
            <a href="/blog/how-car-accident-settlements-are-calculated/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">
              Read Guide &rarr;
            </a>
          </div>

          <!-- Article 2 -->
          <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">
              Legal Geography
            </span>
            <h3 class="text-sm font-bold text-ink mb-3 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/average-car-accident-settlement-by-state/">
                Average Car Accident Settlement Amounts by State 2026
              </a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-6 flex-grow">
              Review a complete breakdown of average settlement values across all 50 US states, and understand why location dramatically affects your claim value.
            </p>
            <a href="/blog/average-car-accident-settlement-by-state/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">
              Read Guide &rarr;
            </a>
          </div>

          <!-- Article 3 -->
          <div class="flex flex-col p-6 rounded-lg border border-hairline bg-canvas-soft hover:border-hairline-strong hover:bg-canvas transition-all duration-200 shadow-sm relative group">
            <span class="text-[9px] font-semibold tracking-wider uppercase text-link font-mono mb-3 block">
              Damages Guide
            </span>
            <h3 class="text-sm font-bold text-ink mb-3 group-hover:text-link transition-colors duration-150 leading-snug">
              <a href="/blog/what-is-pain-and-suffering/">
                What is Pain and Suffering in a Car Accident Claim?
              </a>
            </h3>
            <p class="text-xs text-body leading-relaxed mb-6 flex-grow">
              Understand how non-economic damages are defined, how the multiplier vs per diem methods are applied, and how to document your pain and suffering.
            </p>
            <a href="/blog/what-is-pain-and-suffering/" class="text-[11px] font-semibold text-link inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-150">
              Read Guide &rarr;
            </a>
          </div>
        </div>

        <div class="text-center">
          <a 
            href="/blog/" 
            class="inline-flex items-center justify-center px-6 py-2.5 text-xs font-semibold rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-hairline-strong transition-all duration-150 text-ink"
          >
            Browse All Guides
          </a>
        </div>
      </div>
    </section>

    <!-- State Directory Link Section -->
    <StateDirectory />
  </main>

  <!-- Footer Navigation -->
  <Footer />
</Layout>
